# Server-only local configuration. Copy to .env; never commit that file.
BAYBAYIN_REFERENCE_TOKEN=replace-with-a-long-random-local-token

# Optional explanation layer. The validator still makes every correctness decision.
AI_GATEWAY_API_KEY=replace-with-your-ai-gateway-key
# Use an exact current model identifier returned by your AI Gateway, e.g. provider/model.
AI_GATEWAY_MODEL=provider/model
